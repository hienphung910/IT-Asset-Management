# Copy file này thành .env rồi điền mật khẩu MySQL của máy bạn.
# File .env không được đưa lên Git.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=itam

# Tài khoản admin đầu tiên. Server tạo tài khoản này ở lần chạy đầu, khi chưa có admin nào.
# Bắt buộc điền ADMIN_PASSWORD (ít nhất 8 ký tự), nếu không server sẽ không khởi động.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Tùy chọn: agent báo cáo cấu hình máy mỗi bao nhiêu phút (mặc định 360 = 6 giờ, tối thiểu 5).
# AGENT_REPORT_INTERVAL_MINUTES=360
